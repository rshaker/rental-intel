{
    "name": "@rshaker/rental-intel",
    "version": "0.1.0",
    "description": "Chrome extension that captures rental listings from several sites into local, searchable records",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Ron Shaker",
        "email": "rshaker@gmail.com",
        "url": "https://github.com/rshaker"
    },
    "bugs": {
        "url": "https://github.com/rshaker/rental-intel/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rshaker/rental-intel.git"
    },
    "homepage": "https://github.com/rshaker/rental-intel",
    "keywords": [
        "apartments",
        "chrome",
        "crxjs",
        "dexie",
        "extension",
        "indexeddb",
        "mv3",
        "rentals",
        "scraper",
        "typescript",
        "vite",
        "zillow"
    ],
    "scripts": {
        "dev": "vite",
        "build": "npm run clean && npm run typecheck && vite build",
        "build:e2e": "rimraf dist-e2e && E2E=1 vite build",
        "build:watch": "npm run clean && vite build --watch",
        "browser:link": "PLAYWRIGHT_BROWSERS_PATH=0 node tasks/link-browser.mjs",
        "capture:trim": "node tasks/trim-capture.mjs",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "clean": "rimraf dist",
        "clean:browsers": "rimraf work/browsers",
        "clean:playwright": "rimraf playwright/playwright-report playwright/test-results",
        "clean:docs": "rimraf docs/dist",
        "docs": "typedoc",
        "playwright:install-browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
        "playwright:report": "playwright show-report playwright/playwright-report",
        "playwright:test": "npm run build:e2e && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
        "playwright:test-ui": "npm run build:e2e && PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
        "zip": "RELEASE=1 npm run build && rimraf rental-intel-chrome.zip && cd dist && zip -r -X ../rental-intel-chrome.zip . -x '*.map' -x '.DS_Store'",
        "test:unit": "vitest run",
        "test:unit-watch": "vitest",
        "test": "npm run test:unit && npm run playwright:test"
    },
    "dependencies": {
        "@preact/signals": "^2.11.3",
        "dexie": "^4.4.6",
        "p-limit": "^7.3.3",
        "preact": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@playwright/test": "^1.63.0",
        "@types/chrome": "^0.3.0",
        "@types/node": "^26.6.1",
        "jsdom": "^28.1.0",
        "rimraf": "^6.1.3",
        "typedoc": "^0.28.20",
        "typescript": "~6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "browserslist": [
        "last 2 Chrome versions"
    ],
    "engines": {
        "node": ">=22.12.0"
    }
}
