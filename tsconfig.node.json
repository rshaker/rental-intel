{
    // Files that run in Node rather than in the browser: build configuration,
    // Playwright specs, and the tasks.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        // "chrome" is for the Playwright specs' evaluate callbacks, which run inside the extension.
        "types": ["node", "chrome", "vite/client"],
        "allowJs": true,
        "checkJs": false
    },
    "include": [
        "package.json",
        "vite.config.ts",
        "vitest.config.ts",
        "manifest.config.ts",
        "playwright.config.ts",
        "playwright/**/*.ts",
        "site/**/*.ts",
        "tasks/**/*.mjs",
        "tasks/**/*.ts",
        "src/sources/contract.ts",
        "src/sources/descriptors.ts",
        "src/sources/*/descriptor.ts",
        "src/sources/*/urls.ts"
    ],
    "exclude": ["node_modules", "dist", "dist-e2e"]
}
