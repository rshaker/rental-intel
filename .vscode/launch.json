{
    /**
     * Launches Chrome for Testing with the unpacked extension from ./dist
     * already loaded, into a throwaway profile under ./work/browsers/chrome.
     *
     * Why not /Applications/Google Chrome.app: Google Chrome no longer honours
     * the --load-extension switch (verified on Chrome 152 stable, dev and
     * canary -- the browser opens with no extension in it, silently). Chrome for
     * Testing still honours it. The launcher at work/browsers/chrome-for-testing
     * is generated by `npm run browser:link`, which the preLaunchTasks run.
     *
     * For real apartment hunting, load dist/ into your everyday Chrome by hand
     * at chrome://extensions -- see README.md.
     */
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome (dev server)",
            "request": "launch",
            "type": "chrome",
            "url": "chrome://extensions/",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "${workspaceFolder}/work/browsers/chrome-for-testing",
            "runtimeArgs": [
                "--disable-extensions-except=${workspaceFolder}/dist",
                "--load-extension=${workspaceFolder}/dist",
                // Keeps this unsigned build away from the login keychain, which
                // otherwise prompts for "Chromium Safe Storage" on every launch.
                // The throwaway profile has no passwords or cookies to protect.
                "--use-mock-keychain"
            ],
            "userDataDir": "${workspaceFolder}/work/browsers/chrome",
            "preLaunchTask": "vite dev",
            "sourceMaps": true
        },
        {
            "name": "Launch Chrome (built extension)",
            "request": "launch",
            "type": "chrome",
            "url": "chrome://extensions/",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "${workspaceFolder}/work/browsers/chrome-for-testing",
            "runtimeArgs": [
                "--disable-extensions-except=${workspaceFolder}/dist",
                "--load-extension=${workspaceFolder}/dist",
                // Keeps this unsigned build away from the login keychain, which
                // otherwise prompts for "Chromium Safe Storage" on every launch.
                // The throwaway profile has no passwords or cookies to protect.
                "--use-mock-keychain"
            ],
            "userDataDir": "${workspaceFolder}/work/browsers/chrome",
            "preLaunchTask": "build extension",
            "sourceMaps": true
        }
    ]
}
