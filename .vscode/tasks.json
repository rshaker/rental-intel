{
    "version": "2.0.0",
    "tasks": [
        {
            // Regenerates work/browsers/chrome-for-testing. Cheap, and it keeps
            // the launcher pointing at the right Playwright build after upgrades.
            "label": "link dev browser",
            "type": "npm",
            "script": "browser:link",
            "problemMatcher": []
        },
        {
            "label": "build extension",
            "type": "npm",
            "script": "build",
            "dependsOn": ["link dev browser"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$tsc"]
        },
        {
            // Long-running dev server. VS Code needs the `background` block to
            // know when to stop waiting and launch the browser -- endsPattern is
            // what Vite prints once dist/ has been written.
            //
            // The `pattern` below deliberately matches only real "file(1,2): msg"
            // diagnostics. A catch-all regexp here makes VS Code treat every line
            // of ordinary output as a problem, which is what produces the
            // "Errors exist after running preLaunchTask" dialog.
            "label": "vite dev",
            "type": "npm",
            "script": "dev",
            "isBackground": true,
            "dependsOn": ["link dev browser"],
            "dependsOrder": "sequence",
            "problemMatcher": {
                "owner": "vite",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^([^\\s].*)\\((\\d+,\\d+)\\):\\s*(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*(building|rebuilding|hmr update).*$",
                    "endsPattern": "^.*(ready in|built in|page reload).*$"
                }
            }
        }
    ]
}
