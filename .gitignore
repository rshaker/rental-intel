# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependency directories
node_modules

# build output
/dist
/dist-e2e
/*.zip
/docs/dist

# playwright artifacts (keep the specs, harness and fixtures)
/playwright/*
!/playwright/specs
!/playwright/specs/**
!/playwright/harness
!/playwright/harness/**
# The specs read these at import time, so a clone without them cannot run the
# suite. Mind what you commit here: a real captured listing page can carry
# your account context. See the header of each fixture.
!/playwright/fixtures
!/playwright/fixtures/**

# secrets for testing
.env

# ide and editor configuration
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.claude/

# purgeable, throw-away files
/tmp
/trash
/work

# developer notes, never published (ARCHITECTURE.md is tracked on dev only)
/admin/

# miscellaneous
.DS_Store

# npm
.npmrc
